{
  "name": "todopop",
  "productName": "TODOPOP",
  "version": "0.1.2",
  "description": "A to-do app whose tasks float on your screen as bubbles and slowly take it over until you pop them.",
  "main": "main.js",
  "author": "TODOPOP",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.todopop.desktop",
    "productName": "TODOPOP",
    "files": [
      "main.js",
      "openwin.js",
      "preload.js",
      "app/**",
      "assets/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": "-",
      "artifactName": "TODOPOP-mac.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "TODOPOP-windows-setup.${ext}"
    },
    "dmg": {
      "title": "TODOPOP"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "TODOPOP",
      "artifactName": "TODOPOP-windows-setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "nosugarlessice",
      "repo": "todopop",
      "releaseType": "release"
    }
  },
  "repository": "github:nosugarlessice/todopop",
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
